# =============================================================
# NexLedger Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to source control.
# =============================================================

# PostgreSQL connection string (Supabase session pooler recommended for production)
# Format: postgresql://user:password@host:port/database
# NEVER expose this to the frontend or prefix with NEXT_PUBLIC_
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# HTTP port the server listens on
# Render injects PORT automatically; set to 5000 for local development
PORT=5000

# Application environment: development | test | production
NODE_ENV=development

# JSON Web Token signing secret
# MUST be at least 32 characters in production — use a cryptographically random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# JWT expiration duration (e.g. 1d, 7d, 12h)
JWT_EXPIRES_IN=7d

# Allowed CORS origins — comma-separated for multiple origins
# Example production value: https://your-app.onrender.com
CORS_ORIGIN=http://localhost:5173

# bcrypt work factor (8–14). Higher = slower hashing but more secure.
# 10 is a good default; use 12 for production
BCRYPT_ROUNDS=10
