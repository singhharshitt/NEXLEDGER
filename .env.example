# NexLedger - Environment Variables Example
# Copy this file to `server/.env` and configure for your local environment

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexledger_db

# Secret key for JWT signing (Must be at least 32 chars in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars!

# Express server port
PORT=5000

# Application Environment (development, test, production)
NODE_ENV=development

# Allowed CORS origins (Comma separated)
CORS_ORIGIN=http://localhost:5173

# JWT Expiration
JWT_EXPIRES_IN=7d

# Bcrypt Hash Rounds (10 is standard)
BCRYPT_ROUNDS=10
